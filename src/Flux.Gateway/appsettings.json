{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payments-create": {
        "ClusterId": "payments",
        "Match": { "Path": "/v1/payments", "Methods": [ "POST" ] },
        "Metadata": { "RouteGroup": "payments" },
        "Transforms": [ { "PathSet": "/payments" } ]
      },
      "payments-get": {
        "ClusterId": "payments",
        "Match": { "Path": "/v1/payments/{id}", "Methods": [ "GET" ] },
        "Metadata": { "RouteGroup": "payments" },
        "Transforms": [ { "PathPattern": "/payments/{id}" } ]
      },
      "refunds-create": {
        "ClusterId": "refunds",
        "Match": { "Path": "/v1/refunds", "Methods": [ "POST" ] },
        "Metadata": { "RouteGroup": "refunds" },
        "Transforms": [ { "PathSet": "/refunds" } ]
      },
      "refunds-get": {
        "ClusterId": "refunds",
        "Match": { "Path": "/v1/refunds/{id}", "Methods": [ "GET" ] },
        "Metadata": { "RouteGroup": "refunds" },
        "Transforms": [ { "PathPattern": "/refunds/{id}" } ]
      }
    },
    "Clusters": {
      "payments": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "d1": { "Address": "http://localhost:5201" } }
      },
      "refunds": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "d1": { "Address": "http://localhost:5202" } }
      }
    }
  }
}
